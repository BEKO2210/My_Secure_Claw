{
  "agents": {
    "defaults": {
      "workspace": "./workspace",
      "model": {
        "primary": "ollama/gemma4:e2b"
      },
      "experimental": {
        "localModelLean": true
      },
      "timeoutSeconds": 360
    }
  },
  "gateway": {
    "mode": "local",
    "bind": "lan",
    "port": 18789,
    "auth": {
      "mode": "token",
      "token": {
        "source": "env",
        "provider": "default",
        "id": "OPENCLAW_GATEWAY_TOKEN"
      }
    },
    "controlUi": {
      "enabled": true
    },
    "tailscale": {
      "mode": "off",
      "resetOnExit": false
    }
  },
  "session": {
    "dmScope": "per-channel-peer"
  },
  "tools": {
    "profile": "coding"
  },
  "plugins": {
    "entries": {
      "ollama": {
        "enabled": true
      },
      "telegram": {
        "enabled": true
      },
      "canvas": {
        "enabled": false
      },
      "browser": {
        "enabled": false
      },
      "talk-voice": {
        "enabled": false
      },
      "phone-control": {
        "enabled": false
      },
      "file-transfer": {
        "enabled": false
      },
      "device-pair": {
        "enabled": false
      },
      "memory-core": {
        "enabled": true
      }
    }
  },
  "models": {
    "mode": "merge",
    "providers": {
      "ollama": {
        "api": "ollama",
        "baseUrl": "http://127.0.0.1:11434",
        "apiKey": "OLLAMA_API_KEY",
        "timeoutSeconds": 360,
        "models": [
          {
            "id": "gemma4:e2b",
            "name": "Gemma 4 e2b (CPU-fast, multimodal)",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 8192,
            "maxTokens": 8192,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsUsageInStreaming": true
            },
            "params": {
              "num_ctx": 8192,
              "keep_alive": "30m",
              "thinking": false
            }
          },
          {
            "id": "gemma4:e4b",
            "name": "Gemma 4 e4b (quality, needs ~10GiB RAM)",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 8192,
            "maxTokens": 8192,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsUsageInStreaming": true
            },
            "params": {
              "num_ctx": 8192,
              "keep_alive": "30m",
              "thinking": false
            }
          },
          {
            "id": "phi4-mini",
            "name": "Phi-4 mini 3.8B (text-only alternative)",
            "input": [
              "text"
            ],
            "contextWindow": 8192,
            "maxTokens": 8192,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsUsageInStreaming": true
            },
            "params": {
              "num_ctx": 8192,
              "keep_alive": "30m",
              "thinking": false
            }
          },
          {
            "id": "qwen2.5:7b-instruct-q4_K_M",
            "name": "Qwen 2.5 7B Instruct Q4_K_M (GPU-local; no thinking mode)",
            "input": [
              "text"
            ],
            "contextWindow": 8192,
            "maxTokens": 8192,
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsUsageInStreaming": true
            },
            "params": {
              "num_ctx": 8192,
              "keep_alive": "30m",
              "thinking": false
            }
          }
        ],
        "contextWindow": 8192
      },
      "openrouter": {
        "api": "openai-completions",
        "baseUrl": "https://openrouter.ai/api/v1",
        "apiKey": "OPENROUTER_API_KEY",
        "timeoutSeconds": 60,
        "models": [
          {
            "id": "openai/gpt-4o-mini",
            "name": "OpenRouter gpt-4o-mini (cloud fast)",
            "input": [
              "text",
              "image"
            ],
            "contextWindow": 128000,
            "maxTokens": 16384,
            "cost": {
              "input": 0.15,
              "output": 0.6,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "compat": {
              "supportsTools": true,
              "supportsUsageInStreaming": true
            }
          }
        ]
      }
    }
  },
  "channels": {
    "telegram": {
      "enabled": true,
      "dmPolicy": "pairing"
    }
  },
  "skills": {
    "install": {
      "nodeManager": "pnpm"
    }
  }
}
