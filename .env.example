# My_Secure_Claw — OpenClaw + Gemma 4 (via Ollama)
# Copy this file to `.env` and adjust as needed. Never commit secrets.

# -----------------------------------------------------------------------------
# Gateway auth (required when the gateway binds beyond loopback)
# Generate with: openssl rand -hex 32
# Leave blank to let OpenClaw auto-generate on first start.
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# Ollama / Gemma 4 (local)
# -----------------------------------------------------------------------------
# Marker accepted by OpenClaw for loopback/LAN Ollama hosts (no real bearer
# token needed). Use a real OLLAMA_API_KEY only when pointing at a remote
# Ollama host or https://ollama.com.
OLLAMA_API_KEY=ollama-local
OLLAMA_HOST=http://127.0.0.1:11434

# Default model for this stack. Override per environment if you have a bigger
# machine (gemma4:26b for consumer GPUs, gemma4:31b for workstations).
OPENCLAW_PRIMARY_MODEL=ollama/gemma4:e4b
