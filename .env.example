# My_Secure_Claw — OpenClaw + Gemma 4 (via Ollama)
# Copy this file to `.env` and fill in real values. Never commit secrets.

# -----------------------------------------------------------------------------
# Gateway auth — REQUIRED for LAN bind
# Generate with: openssl rand -hex 32
# -----------------------------------------------------------------------------
OPENCLAW_GATEWAY_TOKEN=

# -----------------------------------------------------------------------------
# Ollama / Gemma 4 (local)
# -----------------------------------------------------------------------------
# Marker accepted by OpenClaw for loopback/LAN Ollama hosts (no real bearer
# token needed). Replace with a real OLLAMA_API_KEY only when pointing at a
# remote Ollama host or https://ollama.com.
OLLAMA_API_KEY=ollama-local
OLLAMA_HOST=http://127.0.0.1:11434

# Default model for this stack. Override if you run on bigger/smaller hardware:
#   gemma4:e2b (mobile, ~4 GiB RAM)
#   gemma4:e4b (edge,   ~10 GiB RAM)
#   gemma4:26b (consumer GPU)
#   gemma4:31b (workstation GPU)
OPENCLAW_PRIMARY_MODEL=ollama/gemma4:e4b

# -----------------------------------------------------------------------------
# Channels
# -----------------------------------------------------------------------------
# Telegram: get a bot token from https://t.me/BotFather
TELEGRAM_BOT_TOKEN=
